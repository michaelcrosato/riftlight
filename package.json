{
  "name": "pixel-engine",
  "private": true,
  "version": "0.45.0",
  "license": "MIT",
  "type": "module",
  "description": "WebGPU-first 3D engine that renders authentic 2D pixel art, built for AI agents to generate classic games.",
  "homepage": "https://riftlight.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelcrosato/riftlight"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --logLevel warn && node scripts/bundle.mjs --out dist/engine",
    "bundle": "node scripts/bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . && node scripts/forbidden-apis.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo && tsc --noEmit -p tsconfig.scripts.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/scripts.tsbuildinfo",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "build:single": "node scripts/build-single.mjs",
    "anim": "tsx scripts/anim.ts",
    "film": "tsx scripts/film.ts",
    "gate-b": "tsx scripts/gate-b.ts",
    "loot": "tsx scripts/riftlight/loot.ts",
    "tree": "tsx scripts/riftlight/tree.ts",
    "level": "tsx scripts/riftlight/level.ts",
    "combat": "tsx scripts/riftlight/combat.ts",
    "monster": "tsx scripts/riftlight/monster.ts",
    "playtest": "tsx scripts/riftlight/playtest.ts",
    "replay": "tsx scripts/replay.ts",
    "balance": "tsx scripts/riftlight/balance.ts",
    "inspect": "tsx scripts/inspect.ts",
    "model": "tsx scripts/model.ts",
    "tex": "tsx scripts/tex.ts",
    "look": "node scripts/look.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright-core": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
